{
  // cv.yaml is validated against cv.schema.json (autocomplete + errors) by the YAML extension.
  "yaml.schemas": { "./cv.schema.json": "cv.yaml" },
  "[yaml]": { "editor.wordWrap": "on" },
  "files.associations": { "*.cls": "latex", "*.tex.j2": "latex", "*.html.j2": "jinja-html" },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "files.exclude": { "**/__pycache__": true }
}
