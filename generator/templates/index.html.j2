<!doctype html>
{# GENERATED page template: content comes from cv.yaml. #}
{% set full_name = basics.first_name ~ ' ' ~ basics.last_name %}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ full_name }} · CV</title>
  <meta name="description" content="{{ full_name }}, {{ basics.tagline }}. Curriculum vitae.">
  <meta property="og:title" content="{{ full_name }} · CV">
  <meta property="og:description" content="{{ basics.tagline }}">
  <meta property="og:type" content="profile">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23000066'/%3E%3Ctext x='32' y='43' font-family='Arial' font-size='30' font-weight='700' fill='white' text-anchor='middle'%3E{{ basics.first_name[0] }}{{ basics.last_name[0] }}%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,300&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <style>
    :root {
      --bg: #f4f5f9;
      --paper: #ffffff;
      --text: #1d1f2b;
      --muted: #5c6070;
      --rule: #dfe1ea;
      --accent: #000066;
      --accent-soft: #e8e8f6;
      --tag-border: #c9cbd6;
      --shadow: 0 1px 2px rgba(16, 18, 40, .06), 0 8px 28px rgba(16, 18, 40, .07);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1016;
        --paper: #171923;
        --text: #e6e7ee;
        --muted: #9a9db0;
        --rule: #2a2d3c;
        --accent: #a9b0ff;
        --accent-soft: #23264a;
        --tag-border: #3a3e52;
        --shadow: none;
      }
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 300 16px/1.55 "Source Sans 3", "Source Sans Pro", system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    strong { font-weight: 600; }

    .page {
      max-width: 920px;
      margin: 40px auto;
      padding: 48px 56px;
      background: var(--paper);
      border-radius: 14px;
      box-shadow: var(--shadow);
    }

    /* Header */
    header { display: flex; gap: 24px; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; }
    h1 { margin: 0; font-size: 2.4rem; line-height: 1.1; font-weight: 300; color: var(--accent); letter-spacing: -.01em; }
    h1 b { font-weight: 700; font-variant: small-caps; letter-spacing: .02em; }
    .tagline { margin: 4px 0 14px; font-size: 1.2rem; font-weight: 600; color: var(--accent); }
    .contact { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; padding: 0; list-style: none; font-size: .95rem; }
    .contact li { display: inline-flex; align-items: center; gap: 8px; }
    .contact .fa { color: var(--accent); width: 1em; text-align: center; }
    .actions { display: flex; gap: 10px; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px; border-radius: 8px;
      background: var(--accent); color: var(--paper);
      font-weight: 600; font-size: .95rem; white-space: nowrap;
    }
    .btn:hover { text-decoration: none; filter: brightness(1.15); }

    .summary { margin: 26px 0 0; }

    /* Sections */
    section { margin-top: 30px; }
    h2 {
      display: flex; align-items: center; gap: 10px;
      margin: 0 0 14px; padding-bottom: 6px;
      border-bottom: 1px solid var(--rule);
      font-size: 1.35rem; font-weight: 400; color: var(--accent);
      font-variant: small-caps; letter-spacing: .03em;
    }
    h2 .fa { font-size: 1.05rem; }

    .skills { display: grid; grid-template-columns: 190px 1fr; gap: 6px 18px; margin: 0; }
    .skills dt { font-weight: 600; text-align: right; }
    .skills dd { margin: 0; }

    .entry { display: grid; grid-template-columns: 110px 1fr; gap: 0 22px; padding: 14px 0; }
    .entry + .entry { border-top: 1px dashed var(--rule); }
    .dates { text-align: right; font-weight: 600; font-size: .9rem; color: var(--muted); line-height: 1.7; }
    .dates span { display: block; }
    .body { border-left: 2px solid var(--accent-soft); padding-left: 18px; min-width: 0; }
    h3 { margin: 0; font-size: 1.05rem; font-weight: 600; }
    h3 .where { color: var(--muted); font-weight: 400; }
    .entry p { margin: 4px 0 0; }
    .entry ul { margin: 8px 0 0; padding-left: 1.1em; }
    .entry li { margin: 3px 0; }
    .entry li::marker { content: "\203A  "; color: var(--accent); font-weight: 700; }
    .tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 10px 0 0; padding: 0; list-style: none; }
    .tags li {
      padding: 1px 8px; border: 1px solid var(--tag-border); border-radius: 5px;
      font-size: .78rem; font-weight: 400; color: var(--muted);
    }

    .list { display: grid; grid-template-columns: 110px 1fr; gap: 6px 22px; margin: 0; }
    .list dt { text-align: right; font-weight: 600; color: var(--muted); }
    .list dd { margin: 0; }

    footer { margin: 0 auto 40px; text-align: center; font-size: .85rem; color: var(--muted); }

    @media (max-width: 720px) {
      .page { margin: 0; padding: 28px 16px; border-radius: 0; box-shadow: none; }
      h1 { font-size: 2rem; }
      .actions { width: 100%; }
      .skills, .list { grid-template-columns: 1fr; gap: 2px 0; }
      .skills dt, .list dt { text-align: left; margin-top: 8px; }
      .entry { grid-template-columns: 1fr; }
      .dates { text-align: left; margin-bottom: 4px; }
      .dates span { display: inline; }
      .dates span + span::before { content: " – "; }
      .body { border-left: 0; padding-left: 0; }
      footer { margin: 20px 16px 28px; }
    }

    @media print {
      body { background: #fff; color: #000; font-size: 11pt; }
      .page { margin: 0; padding: 0; box-shadow: none; max-width: none; }
      .actions, footer { display: none; }
      .entry { break-inside: avoid; }
      .new-page { break-before: page; }
    }
  </style>
</head>
<body>
  <main class="page">
    <header>
      <div>
        <h1>{{ basics.first_name }} <b>{{ basics.last_name }}</b></h1>
        <p class="tagline">{{ basics.tagline }}</p>
        <ul class="contact">
          {% if basics.linkedin %}<li><i class="fa fa-linkedin" aria-hidden="true"></i><a href="https://www.linkedin.com/in/{{ basics.linkedin }}/">linkedin.com/in/{{ basics.linkedin }}</a></li>{% endif %}
          {% if basics.github %}<li><i class="fa fa-github" aria-hidden="true"></i><a href="https://github.com/{{ basics.github }}">github.com/{{ basics.github }}</a></li>{% endif %}
          {% if basics.website %}<li><i class="fa fa-link" aria-hidden="true"></i><a href="{{ basics.website }}">{{ basics.website }}</a></li>{% endif %}
          <li><i class="fa fa-at" aria-hidden="true"></i><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></li>
          <li><i class="fa fa-mobile" aria-hidden="true"></i>{{ phone }}</li>
          {% if basics.location %}<li><i class="fa fa-map-marker" aria-hidden="true"></i>{{ basics.location }}</li>{% endif %}
          {% if basics.info %}<li><i class="fa fa-info" aria-hidden="true"></i>{{ basics.info }}</li>{% endif %}
        </ul>
      </div>
      <div class="actions">
        <a class="btn" href="cv.pdf" download="{{ basics.first_name }}-{{ basics.last_name }}-CV.pdf"><i class="fa fa-download" aria-hidden="true"></i>Download PDF</a>
      </div>
    </header>

    {% for section in cv.sections %}
    {% if section.type == 'summary' %}
    <p class="summary">{{ section.text|html }}</p>

    {% elif section.type == 'skills' %}
    <section{% if section.new_page %} class="new-page"{% endif %}>
      <h2><i class="fa fa-{{ section.icon or 'tasks' }}" aria-hidden="true"></i>{{ section.title }}</h2>
      <dl class="skills">
        {% for item in section['items'] %}
        <dt>{{ item.name }}</dt>
        <dd>{{ item.value|html }}</dd>
        {% endfor %}
      </dl>
    </section>

    {% elif section.type == 'experience' %}
    <section{% if section.new_page %} class="new-page"{% endif %}>
      <h2><i class="fa fa-{{ section.icon or 'suitcase' }}" aria-hidden="true"></i>{{ section.title }}</h2>
      {% for e in section.entries %}
      <article class="entry">
        <div class="dates"><span>{{ e.start }}</span>{% if e.end %}<span>{{ e.end }}</span>{% endif %}</div>
        <div class="body">
          <h3>{% if e.url %}<a href="{{ e.url }}">{{ e.organization }}</a>{% else %}{{ e.organization }}{% endif %}{% if e.location or e.title %}<span class="where">{% if e.location %}, {{ e.location }}{% endif %}{% if e.title %}, {{ e.title }}{% endif %}</span>{% endif %}</h3>
          {% if e.summary %}<p>{{ e.summary|html }}</p>{% endif %}
          {% if e.highlights %}
          <ul>
            {% for h in e.highlights %}
            <li>{{ h|html }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if e.tags %}
          <ul class="tags" aria-label="Technologies">
            {% for t in e.tags %}<li>{{ t }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </section>

    {% elif section.type == 'list' %}
    <section{% if section.new_page %} class="new-page"{% endif %}>
      <h2><i class="fa fa-{{ section.icon or 'certificate' }}" aria-hidden="true"></i>{{ section.title }}</h2>
      <dl class="list">
        {% for item in section['items'] %}
        <dt>{{ item.date or '' }}</dt>
        <dd>{{ item.text|html }}</dd>
        {% endfor %}
      </dl>
    </section>
    {% endif %}
    {% endfor %}
  </main>
  <footer>Updated {{ updated.strftime('%B %Y') }} · <a href="cv.pdf">PDF version</a></footer>
</body>
</html>
